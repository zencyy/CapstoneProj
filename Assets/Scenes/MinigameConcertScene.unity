  phaseTwoPromptText: {fileID: 919256472}
  promptDisplayTime: 4
  voiceOverSource: {fileID: 2756317}
  subtitleDisplay: {fileID: 1153693320}
  timedVoiceOvers:
  - triggerTime: 50
    subtitleText: My chest... I can't get any air. I'm going to pass out.
    clip: {fileID: 8300000, guid: d889dc743d0d9e644b82b1eb14db06da, type: 3}
    hasPlayed: 0
  - triggerTime: 40
    subtitleText: I can't do this. It's too much. It's just too much.
    clip: {fileID: 8300000, guid: caa4df01b77a70a4e9827fc61eb2d307, type: 3}
    hasPlayed: 0
  - triggerTime: 25
    subtitleText: You shouldn't have come. This was a mistake.
    clip: {fileID: 8300000, guid: daef15419c0afe84db0cd9c1b91e86bc, type: 3}
    hasPlayed: 0
  - triggerTime: 10
    subtitleText: Focus. Just find something to focus on.
    clip: {fileID: 8300000, guid: e60dd06702ece4a4d9bed7fcaac4c4bb, type: 3}
    hasPlayed: 0
  globalVolume: {fileID: 822363708}
  targetChromaticIntensity: 1
  targetVignetteIntensity: 0.45
  vfxFadeDuration: 1
  winVoiceOverClip: {fileID: 8300000, guid: e104467cbe2ba064f87349dd9c22448a, type: 3}
  winSubtitleText: Finally here.. I can enjoy the concert now
