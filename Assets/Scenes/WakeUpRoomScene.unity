  - text: I just wanted it to stay perfect for one morning.
    duration: 3
  - text: My chest... I can't leave until this is exactly how I left it."
    duration: 6
  initialDelay: 3
  maxDarkness: 0.75
  objectiveText: {fileID: 1084103069}
  objectiveString: Everything is out of place... I need to put it back.
  objectiveFadeDuration: 1.5
  objectiveStayDuration: 3
